# ==============================================================================
# Airi Sensei v3.0 - Environment Configuration Template (.env.example)
# IMPORTANT: Never commit actual secret keys or tokens into version control!
# ==============================================================================

# --- OpenClaw Gateway Control Plane ---
OPENCLAW_GATEWAY_TOKEN=replace_with_a_secure_random_token_e.g_openssl_rand_hex_32
OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json
OPENCLAW_WORKSPACE=/data/workspace
OPENCLAW_HOME=/data/.openclaw

# --- Telegram Bot Channel Configuration ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs allowed to chat with Airi (Owner Whitelist)
ALLOWED_USER_IDS=5556841083

# --- LLM Providers Cascade (Tier 1 -> Tier 2 -> Tier 3) ---
# Tier 1: Groq Cloud (Ultra-fast LPU inference, 120B Flagship)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Tier 2: Google Gemini (1M Context, deep multimodal reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-flash-latest

# Tier 3: OpenRouter (Free tier models fallback)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free

# --- Image Generation Engine (Pollinations Flux / Turbo) ---
IMAGE_MODEL=flux
IMAGE_FALLBACK_MODEL=turbo

# --- Server & Render Web Service ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO
